<%
    const curPage = parseInt(locals.page, 10) || 1;
    const totalPagesCount = parseInt(locals.totalPages, 10) || 0;
    const totalItems = parseInt(locals.totalRows, 10) || 0;
    const pageSize = parseInt(locals.limit, 10) || 10;
    const itemType = locals.itemLabel || 'items';
    const baseUrl = locals.baseUrl || '';

    // Calculate record range
    const startItem = totalItems > 0 ? (curPage - 1) * pageSize + 1 : 0;
    const endItem = Math.min(curPage * pageSize, totalItems);

    // Build query string excluding 'page' to prevent duplicate or conflicting parameters
    const params = new URLSearchParams();

    if (locals.queryParams && typeof locals.queryParams === 'object') {
        Object.entries(locals.queryParams).forEach(([k, v]) => {
            if (k !== 'page' && v !== undefined && v !== null && v !== '') {
                params.set(k, String(v));
            }
        });
    } else if (typeof locals.queryParams === 'string' && locals.queryParams.trim()) {
        const str = locals.queryParams.startsWith('?') ? locals.queryParams.slice(1) : locals.queryParams;
        const sp = new URLSearchParams(str);
        sp.forEach((v, k) => {
            if (k !== 'page' && v !== '') {
                params.set(k, v);
            }
        });
    }

    // Helper to generate target page URL
    function getPageUrl(targetPage) {
        const p = new URLSearchParams(params.toString());
        p.set('page', targetPage);
        const qs = p.toString();
        return qs ? `${baseUrl}?${qs}` : `${baseUrl}?page=${targetPage}`;
    }
%>

<% if (totalItems > 0 || totalPagesCount > 1) { %>
    <nav class="pagination-wrapper" aria-label="Pagination Navigation">
        <div class="pagination-info">
            Showing <strong><%= startItem %></strong>–<strong><%= endItem %></strong> of <strong><%= totalItems %></strong> <%= itemType %>
        </div>

        <% if (totalPagesCount > 1) { %>
            <div class="pagination-controls">
                <% if (curPage > 1) { %>
                    <a href="<%= getPageUrl(curPage - 1) %>" class="btn btn-secondary btn-sm" aria-label="Go to previous page">
                        <i data-lucide="chevron-left" aria-hidden="true"></i>
                        <span>Previous</span>
                    </a>
                <% } else { %>
                    <button type="button" class="btn btn-secondary btn-sm" disabled aria-disabled="true">
                        <i data-lucide="chevron-left" aria-hidden="true"></i>
                        <span>Previous</span>
                    </button>
                <% } %>

                <span class="pagination-current" aria-current="page">
                    Page <%= curPage %> of <%= totalPagesCount %>
                </span>

                <% if (curPage < totalPagesCount) { %>
                    <a href="<%= getPageUrl(curPage + 1) %>" class="btn btn-secondary btn-sm" aria-label="Go to next page">
                        <span>Next</span>
                        <i data-lucide="chevron-right" aria-hidden="true"></i>
                    </a>
                <% } else { %>
                    <button type="button" class="btn btn-secondary btn-sm" disabled aria-disabled="true">
                        <span>Next</span>
                        <i data-lucide="chevron-right" aria-hidden="true"></i>
                    </button>
                <% } %>
            </div>
        <% } %>
    </nav>
<% } %>
