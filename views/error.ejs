<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title><%= locals.title || 'Access Restricted - Library Management System' %></title>
</head>
<body>
    <div class="auth-wrapper fade-in">
        <main class="auth-card" role="main" style="text-align: center;">
            <header class="auth-header">
                <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--danger-bg); color: var(--danger); display: inline-flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
                    <i data-lucide="shield-alert" style="width: 28px; height: 28px;"></i>
                </div>
                <h1 class="auth-title"><%= locals.status || 403 %> Access Restricted</h1>
                <p class="auth-subtitle"><%= locals.message || 'You do not have permission to access this resource.' %></p>
            </header>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-6);">
                <% if (locals.user && locals.user.role === 'admin') { %>
                    <a href="/admin" class="btn btn-primary" style="justify-content: center;">
                        <i data-lucide="layout-dashboard"></i> Return to Admin Dashboard
                    </a>
                <% } else if (locals.user && locals.user.role === 'member') { %>
                    <a href="/member" class="btn btn-primary" style="justify-content: center;">
                        <i data-lucide="layout-dashboard"></i> Return to Member Dashboard
                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary" style="justify-content: center;">
                        <i data-lucide="log-in"></i> Sign In
                    </a>
                <% } %>
                <a href="/" class="btn btn-ghost" style="justify-content: center;">
                    <i data-lucide="arrow-left"></i> Home
                </a>
            </div>
        </main>
    </div>
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
