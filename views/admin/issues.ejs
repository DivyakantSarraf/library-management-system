<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title>Circulation - Admin Panel</title>
    <style>
        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-4);
            margin-bottom: var(--space-6);
            align-items: center;
            justify-content: space-between;
        }
        .toolbar-filters {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-3);
            flex: 1;
        }
        .search-field {
            position: relative;
            max-width: 400px;
            flex: 1;
            min-width: 200px;
        }
        .search-field input {
            padding-left: var(--space-8);
        }
        .search-field i {
            position: absolute;
            left: var(--space-3);
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            width: 16px;
        }
        
        .pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-4) 0;
            margin-top: var(--space-4);
            border-top: 1px solid var(--border-color);
        }
        .pagination-info {
            color: var(--text-secondary);
            font-size: var(--font-size-meta);
        }
        .pagination-controls {
            display: flex;
            gap: var(--space-2);
        }

        /* Drawer */
        .drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.4);
            z-index: 1000;
            display: none;
            opacity: 0;
            transition: opacity var(--transition-normal);
        }
        .drawer-overlay.visible {
            display: block;
            opacity: 1;
        }
        .drawer {
            position: fixed;
            top: 0;
            right: -400px;
            bottom: 0;
            width: 400px;
            max-width: 100vw;
            background-color: var(--surface-color);
            z-index: 1001;
            box-shadow: var(--shadow-lg);
            transition: right var(--transition-normal);
            display: flex;
            flex-direction: column;
        }
        .drawer.open {
            right: 0;
        }
        .drawer-header {
            padding: var(--space-4) var(--space-6);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .drawer-body {
            padding: var(--space-6);
            overflow-y: auto;
            flex: 1;
        }
        .drawer-footer {
            padding: var(--space-4) var(--space-6);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: var(--space-3);
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.4);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.visible {
            display: flex;
        }
        .modal {
            background-color: var(--surface-color);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 400px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }
        .modal-header {
            padding: var(--space-4) var(--space-6);
            border-bottom: 1px solid var(--border-color);
        }
        .modal-body {
            padding: var(--space-6);
        }
        .modal-footer {
            padding: var(--space-4) var(--space-6);
            background-color: var(--bg-color);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: var(--space-3);
        }

        /* Overflow Menu */
        .table-container {
            overflow: visible;
        }
        .icon-btn {
            padding: var(--space-2);
            width: 32px;
            height: 32px;
        }
        .overflow-menu-container {
            position: relative;
        }
        .overflow-menu {
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            min-width: 150px;
            z-index: 10;
            display: none;
            flex-direction: column;
            padding: var(--space-1) 0;
        }
        .overflow-menu.visible {
            display: flex;
        }
        .overflow-item {
            padding: var(--space-2) var(--space-4);
            display: flex;
            align-items: center;
            gap: var(--space-2);
            color: var(--text-primary);
            text-decoration: none;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            font-size: var(--font-size-body);
        }
        .overflow-item:hover {
            background-color: var(--bg-color);
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            bottom: var(--space-6);
            right: var(--space-6);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
        }
        .toast {
            padding: var(--space-3) var(--space-4);
            border-radius: var(--radius-md);
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: center;
            gap: var(--space-3);
            animation: slideUp var(--transition-normal);
        }
        .toast-success { border-left: 4px solid var(--success); }
        .toast-error { border-left: 4px solid var(--danger); }
        .toast-icon { width: 20px; height: 20px; }
        .toast-success .toast-icon { color: var(--success); }
        .toast-error .toast-icon { color: var(--danger); }

        .meta-text {
            color: var(--text-secondary);
            font-size: var(--font-size-meta);
            margin-top: 2px;
        }

        .overdue-text {
            color: var(--danger);
            font-weight: 500;
        }

        @media (max-width: 767px) {
            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }
            .search-field {
                max-width: none;
            }
            .responsive-table th:not(:first-child), .responsive-table td:not(:first-child):not(:last-child) {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="app-layout fade-in">
        <%- include('../partials/admin-sidebar') %>
        
        <div class="main-content">
            <%- include('../partials/topbar') %>
            
            <main class="page-content slide-up">
                <!-- Header -->
                <div style="margin-bottom: var(--space-6);">
                    <h1 style="font-size: var(--font-size-title);">Circulation</h1>
                    <p style="color: var(--text-secondary); margin-top: var(--space-1);">Track issued books, returns, due dates, and circulation activity.</p>
                </div>

                <!-- Toast Notifications Logic via URL query -->
                <div class="toast-container" id="toastContainer"></div>
                
                <!-- Toolbar -->
                <div class="toolbar">
                    <form method="GET" action="/admin/issues" class="toolbar-filters" id="filterForm">
                        <div class="search-field">
                            <i data-lucide="search"></i>
                            <input type="text" name="q" class="form-control" placeholder="Search by book or member" value="<%= locals.search || '' %>">
                        </div>
                        
                        <div style="display: flex; align-items: center; gap: var(--space-2);">
                            <select name="status" class="form-control" onchange="document.getElementById('filterForm').submit()">
                                <option value="">All Statuses</option>
                                <option value="Issued" <%= locals.status === 'Issued' ? 'selected' : '' %>>Issued</option>
                                <option value="Returned" <%= locals.status === 'Returned' ? 'selected' : '' %>>Returned</option>
                                <option value="Overdue" <%= locals.status === 'Overdue' ? 'selected' : '' %>>Overdue</option>
                            </select>
                        </div>
                        
                        <% if (locals.search || locals.status) { %>
                            <a href="/admin/issues" class="btn btn-ghost" style="padding: 0 var(--space-2);">Clear Filters</a>
                        <% } %>
                    </form>

                    <div>
                        <button class="btn btn-primary" onclick="openIssueDrawer()">
                            <i data-lucide="plus"></i> Issue Book
                        </button>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="card" style="padding: 0;">
                    <% if (locals.error && !locals.issues) { %>
                        <div style="padding: var(--space-10); text-align: center;">
                            <i data-lucide="alert-triangle" style="width: 48px; height: 48px; color: var(--danger); margin-bottom: var(--space-4);"></i>
                            <h3 style="font-size: var(--font-size-heading);">Error Loading Circulation Records</h3>
                            <p style="color: var(--text-secondary); margin-top: var(--space-2);"><%= error %></p>
                        </div>
                    <% } else if (issues.length === 0) { %>
                        <div style="padding: var(--space-10) var(--space-6); text-align: center;">
                            <% if (locals.search || locals.status) { %>
                                <i data-lucide="search" style="width: 48px; height: 48px; color: var(--text-muted); opacity: 0.5; margin-bottom: var(--space-4);"></i>
                                <h3 style="font-size: var(--font-size-heading);">No records found</h3>
                                <p style="color: var(--text-secondary); margin-top: var(--space-2);">Try adjusting your search or filters.</p>
                                <a href="/admin/issues" class="btn btn-secondary" style="margin-top: var(--space-4);">Clear Filters</a>
                            <% } else { %>
                                <i data-lucide="book-open" style="width: 48px; height: 48px; color: var(--text-muted); opacity: 0.5; margin-bottom: var(--space-4);"></i>
                                <h3 style="font-size: var(--font-size-heading);">No circulation activity yet</h3>
                                <p style="color: var(--text-secondary); margin-top: var(--space-2);">Issue a book to start tracking circulation.</p>
                                <button class="btn btn-primary" style="margin-top: var(--space-4);" onclick="openIssueDrawer()">Issue Book</button>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="table-container">
                            <table class="table responsive-table">
                                <thead>
                                    <tr>
                                        <th>Book</th>
                                        <th>Member</th>
                                        <th>Issue Date</th>
                                        <th>Due Date</th>
                                        <th>Return Date</th>
                                        <th>Status</th>
                                        <th>Late Days</th>
                                        <th>Fine</th>
                                        <th style="width: 80px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% 
                                    const today = new Date(); 
                                    today.setHours(0,0,0,0);
                                    
                                    issues.forEach(issue => { 
                                        const dueDateObj = new Date(issue.due_date);
                                        const lateDays = issue.lateDays;
                                    %>
                                        <tr>
                                            <td>
                                                <div style="font-weight: 500; color: var(--text-primary);"><%= issue.book_title %></div>
                                                <div class="meta-text"><%= issue.isbn %></div>
                                            </td>
                                            <td>
                                                <div style="font-weight: 500; color: var(--text-primary);"><%= issue.member_name %></div>
                                                <div class="meta-text"><%= issue.member_email %></div>
                                            </td>
                                            <td>
                                                <div style="font-size: var(--font-size-body);">
                                                    <%= new Date(issue.issue_date).toLocaleDateString() %>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="meta-text <%= (issue.status === 'Overdue') ? 'overdue-text' : '' %>">
                                                    <%= dueDateObj.toLocaleDateString() %>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (issue.return_date) { %>
                                                    <div style="font-size: var(--font-size-body);">
                                                        <%= new Date(issue.return_date).toLocaleDateString() %>
                                                    </div>
                                                <% } else { %>
                                                    <span style="color: var(--text-muted);">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (issue.status === 'Issued') { %>
                                                    <span class="badge badge-success">Issued</span>
                                                <% } else if (issue.status === 'Returned') { %>
                                                    <span class="badge" style="background: var(--bg-color); color: var(--text-secondary);">Returned</span>
                                                <% } else if (issue.status === 'Overdue') { %>
                                                    <span class="badge badge-danger">Overdue</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (lateDays > 0) { %>
                                                    <span class="<%= (issue.status === 'Overdue') ? 'overdue-text' : '' %>"><%= lateDays %> days</span>
                                                <% } else { %>
                                                    <span style="color: var(--text-muted);">0 days</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (issue.displayFine > 0) { %>
                                                    <span style="color: var(--danger); font-weight: 500;">₹<%= parseFloat(issue.displayFine).toFixed(2) %></span>
                                                <% } else { %>
                                                    <span style="color: var(--text-muted);">₹0.00</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (issue.status !== 'Returned') { %>
                                                    <div class="overflow-menu-container">
                                                        <button class="btn btn-ghost icon-btn" onclick="toggleMenu('<%= issue.issue_id %>')" aria-label="Circulation actions">
                                                            <i data-lucide="more-vertical" style="width: 16px;"></i>
                                                        </button>
                                                        <div class="overflow-menu" id="menu-<%= issue.issue_id %>">
                                                            <button class="overflow-item" onclick="confirmReturn('<%= issue.issue_id %>', '<%= issue.book_title.replace(/'/g, "\\'") %>', '<%= issue.member_name.replace(/'/g, "\\'") %>')">
                                                                <i data-lucide="corner-down-left" style="width: 14px;"></i> Return Book
                                                            </button>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <span style="color: var(--text-muted); padding-left: var(--space-2);"><i data-lucide="check" style="width: 16px;"></i></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div style="padding: 0 var(--space-6);">
                            <div class="pagination">
                                <div class="pagination-info">
                                    Showing <%= (page - 1) * 10 + 1 %>–<%= Math.min(page * 10, totalRows) %> of <%= totalRows %> records
                                </div>
                                <div class="pagination-controls">
                                    <a href="?q=<%= search %>&status=<%= status %>&page=<%= page - 1 %>" 
                                       class="btn btn-secondary" 
                                       <%= page <= 1 ? 'disabled style="pointer-events:none; opacity:0.5;"' : '' %>>
                                        Previous
                                    </a>
                                    <span style="display:flex; align-items:center; padding:0 var(--space-2); font-weight:500;">
                                        Page <%= page %> of <%= totalPages %>
                                    </span>
                                    <a href="?q=<%= search %>&status=<%= status %>&page=<%= page + 1 %>" 
                                       class="btn btn-secondary"
                                       <%= page >= totalPages ? 'disabled style="pointer-events:none; opacity:0.5;"' : '' %>>
                                        Next
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>
        
        <div class="sidebar-backdrop"></div>
        
        <!-- Issue Book Drawer -->
        <div class="drawer-overlay" id="formDrawerOverlay" onclick="closeDrawer()"></div>
        <div class="drawer" id="formDrawer" aria-modal="true" role="dialog" aria-labelledby="drawerTitle">
            <form id="issueForm" method="POST" action="/admin/issues" onsubmit="return handleFormSubmit()">
                <div class="drawer-header">
                    <h2 id="drawerTitle" style="font-size: var(--font-size-heading);">Issue Book</h2>
                    <button type="button" class="btn btn-ghost icon-btn" onclick="closeDrawer()" aria-label="Close drawer">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label class="form-label" for="book_id">Book *</label>
                        <select id="book_id" name="book_id" class="form-control" required>
                            <option value="">Select an available book</option>
                            <% if (locals.availableBooks && availableBooks.length > 0) { %>
                                <% availableBooks.forEach(book => { %>
                                    <option value="<%= book.book_id %>"><%= book.title %> (Available: <%= book.available_copies %>)</option>
                                <% }) %>
                            <% } %>
                        </select>
                        <% if (!locals.availableBooks || availableBooks.length === 0) { %>
                            <span class="meta-text" style="color: var(--danger);">No books available to issue.</span>
                        <% } %>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="member_id">Member *</label>
                        <select id="member_id" name="member_id" class="form-control" required>
                            <option value="">Select a member</option>
                            <% if (locals.members && members.length > 0) { %>
                                <% members.forEach(member => { %>
                                    <option value="<%= member.member_id %>"><%= member.name %> (<%= member.email %>)</option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="issue_date">Issue Date *</label>
                        <input type="date" id="issue_date" name="issue_date" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="due_date">Due Date *</label>
                        <input type="date" id="due_date" name="due_date" class="form-control" required>
                    </div>
                </div>
                <div class="drawer-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeDrawer()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Issue Book</button>
                </div>
            </form>
        </div>

        <!-- Return Confirmation Modal -->
        <div class="modal-overlay" id="returnModalOverlay">
            <div class="modal" role="dialog" aria-labelledby="returnModalTitle" aria-modal="true">
                <div class="modal-header">
                    <h2 id="returnModalTitle" style="font-size: var(--font-size-heading); display: flex; align-items: center; gap: var(--space-2);">
                        <i data-lucide="corner-down-left"></i> Return Book
                    </h2>
                </div>
                <div class="modal-body">
                    <p style="margin-bottom: var(--space-4);">Return this book?</p>
                    <div style="background-color: var(--bg-color); padding: var(--space-3); border-radius: var(--radius-md); font-size: var(--font-size-body);">
                        <div style="margin-bottom: var(--space-1);"><span style="color: var(--text-secondary);">Book:</span> <strong id="returnBookTitle"></strong></div>
                        <div><span style="color: var(--text-secondary);">Member:</span> <strong id="returnMemberName"></strong></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <form id="returnForm" method="POST" action="">
                        <button type="button" class="btn btn-secondary" onclick="closeReturnModal()">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="returnSubmitBtn">Confirm Return</button>
                    </form>
                </div>
            </div>
        </div>

    </div>
    
    <script src="/js/shell.js"></script>
    <script>
        lucide.createIcons();

        // Toast logic based on URL params
        const urlParams = new URLSearchParams(window.location.search);
        const errorMsg = urlParams.get('error');
        const successMsg = urlParams.get('success');

        if (errorMsg) showToast(errorMsg, 'error');
        if (successMsg) showToast(successMsg, 'success');

        function showToast(message, type) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            const iconName = type === 'success' ? 'check-circle' : 'alert-circle';
            toast.innerHTML = `
                <i data-lucide="${iconName}" class="toast-icon"></i>
                <div style="font-weight: 500;">${message}</div>
            `;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 200);
            }, 5000);
            
            // Clean URL
            const url = new URL(window.location);
            url.searchParams.delete(type);
            window.history.replaceState({}, '', url);
        }

        // Overflow Menu Logic
        let activeMenu = null;
        function toggleMenu(id) {
            const menu = document.getElementById(`menu-${id}`);
            if (activeMenu && activeMenu !== menu) {
                activeMenu.classList.remove('visible');
            }
            if (menu.classList.contains('visible')) {
                menu.classList.remove('visible');
                activeMenu = null;
            } else {
                menu.classList.add('visible');
                activeMenu = menu;
            }
        }

        document.addEventListener('click', (e) => {
            if (activeMenu && !e.target.closest('.overflow-menu-container')) {
                activeMenu.classList.remove('visible');
                activeMenu = null;
            }
        });

        // Drawer Logic
        const drawer = document.getElementById('formDrawer');
        const drawerOverlay = document.getElementById('formDrawerOverlay');
        const form = document.getElementById('issueForm');
        
        function openIssueDrawer() {
            form.reset();
            const today = new Date();
            const defaultDue = new Date();
            defaultDue.setDate(defaultDue.getDate() + 14); // 14 days default
            
            document.getElementById('issue_date').value = today.toISOString().split('T')[0];
            document.getElementById('due_date').value = defaultDue.toISOString().split('T')[0];
            
            drawer.classList.add('open');
            drawerOverlay.classList.add('visible');
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            drawerOverlay.classList.remove('visible');
        }

        function handleFormSubmit() {
            document.getElementById('submitBtn').textContent = 'Issuing...';
            document.getElementById('submitBtn').disabled = true;
            return true;
        }

        // Return Modal Logic
        const returnModal = document.getElementById('returnModalOverlay');
        const returnForm = document.getElementById('returnForm');

        function confirmReturn(id, bookTitle, memberName) {
            document.getElementById('returnBookTitle').textContent = bookTitle;
            document.getElementById('returnMemberName').textContent = memberName;
            returnForm.action = `/admin/issues/${id}/return`;
            returnModal.classList.add('visible');
            if (activeMenu) activeMenu.classList.remove('visible');
        }

        function closeReturnModal() {
            returnModal.classList.remove('visible');
        }

        returnForm.addEventListener('submit', () => {
            document.getElementById('returnSubmitBtn').textContent = 'Returning...';
            document.getElementById('returnSubmitBtn').disabled = true;
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeDrawer();
                closeReturnModal();
            }
        });
    </script>
</body>
</html>
