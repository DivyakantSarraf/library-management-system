<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title>Members - Admin Panel</title>
    <style>
        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-4);
            margin-bottom: var(--space-6);
            align-items: center;
            justify-content: space-between;
        }
        .toolbar-filters {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-3);
            flex: 1;
        }
        .search-field {
            position: relative;
            max-width: 400px;
            flex: 1;
            min-width: 200px;
        }
        .search-field input {
            padding-left: var(--space-8);
        }
        .search-field i {
            position: absolute;
            left: var(--space-3);
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            width: 16px;
        }
        
        .pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-4) 0;
            margin-top: var(--space-4);
            border-top: 1px solid var(--border-color);
        }
        .pagination-info {
            color: var(--text-secondary);
            font-size: var(--font-size-meta);
        }
        .pagination-controls {
            display: flex;
            gap: var(--space-2);
        }

        /* Drawer */
        .drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.4);
            z-index: 1000;
            display: none;
            opacity: 0;
            transition: opacity var(--transition-normal);
        }
        .drawer-overlay.visible {
            display: block;
            opacity: 1;
        }
        .drawer {
            position: fixed;
            top: 0;
            right: -400px;
            bottom: 0;
            width: 400px;
            max-width: 100vw;
            background-color: var(--surface-color);
            z-index: 1001;
            box-shadow: var(--shadow-lg);
            transition: right var(--transition-normal);
            display: flex;
            flex-direction: column;
        }
        .drawer.open {
            right: 0;
        }
        .drawer-header {
            padding: var(--space-4) var(--space-6);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .drawer-body {
            padding: var(--space-6);
            overflow-y: auto;
            flex: 1;
        }
        .drawer-footer {
            padding: var(--space-4) var(--space-6);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: var(--space-3);
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.4);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.visible {
            display: flex;
        }
        .modal {
            background-color: var(--surface-color);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 400px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }
        .modal-header {
            padding: var(--space-4) var(--space-6);
            border-bottom: 1px solid var(--border-color);
        }
        .modal-body {
            padding: var(--space-6);
        }
        .modal-footer {
            padding: var(--space-4) var(--space-6);
            background-color: var(--bg-color);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: var(--space-3);
        }

        /* Overflow Menu */
        .table-container {
            overflow: visible; /* Prevent dropdown clipping */
        }
        .icon-btn {
            padding: var(--space-2);
            width: 32px;
            height: 32px;
        }
        .overflow-menu-container {
            position: relative;
        }
        .overflow-menu {
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            min-width: 150px;
            z-index: 10;
            display: none;
            flex-direction: column;
            padding: var(--space-1) 0;
        }
        .overflow-menu.visible {
            display: flex;
        }
        .overflow-item {
            padding: var(--space-2) var(--space-4);
            display: flex;
            align-items: center;
            gap: var(--space-2);
            color: var(--text-primary);
            text-decoration: none;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            font-size: var(--font-size-body);
        }
        .overflow-item:hover {
            background-color: var(--bg-color);
        }
        .overflow-item.danger {
            color: var(--danger);
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            bottom: var(--space-6);
            right: var(--space-6);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
        }
        .toast {
            padding: var(--space-3) var(--space-4);
            border-radius: var(--radius-md);
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: center;
            gap: var(--space-3);
            animation: slideUp var(--transition-normal);
        }
        .toast-success { border-left: 4px solid var(--success); }
        .toast-error { border-left: 4px solid var(--danger); }
        .toast-icon { width: 20px; height: 20px; }
        .toast-success .toast-icon { color: var(--success); }
        .toast-error .toast-icon { color: var(--danger); }

        .member-meta {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            color: var(--text-secondary);
            font-size: var(--font-size-meta);
            margin-top: 2px;
        }

        @media (max-width: 767px) {
            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }
            .search-field {
                max-width: none;
            }
            .responsive-table th:not(:first-child), .responsive-table td:not(:first-child):not(:last-child) {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="app-layout fade-in">
        <%- include('../partials/admin-sidebar') %>
        
        <div class="main-content">
            <%- include('../partials/topbar') %>
            
            <main class="page-content slide-up">
                <!-- Header -->
                <div style="margin-bottom: var(--space-6);">
                    <h1 style="font-size: var(--font-size-title);">Members</h1>
                    <p style="color: var(--text-secondary); margin-top: var(--space-1);">Manage library members and their membership information.</p>
                </div>

                <!-- Toast Notifications Logic via URL query -->
                <div class="toast-container" id="toastContainer"></div>
                
                <!-- Toolbar -->
                <div class="toolbar">
                    <form method="GET" action="/admin/members" class="toolbar-filters" id="filterForm">
                        <div class="search-field">
                            <i data-lucide="search"></i>
                            <input type="text" name="q" class="form-control" placeholder="Search by name, email, or phone" value="<%= locals.search || '' %>">
                        </div>
                        
                        <% if (locals.search) { %>
                            <a href="/admin/members" class="btn btn-ghost" style="padding: 0 var(--space-2);">Clear Search</a>
                        <% } %>
                    </form>

                    <div>
                        <button class="btn btn-primary" onclick="openAddDrawer()">
                            <i data-lucide="plus"></i> Add Member
                        </button>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="card" style="padding: 0;">
                    <% if (locals.error && !locals.members) { %>
                        <div style="padding: var(--space-10); text-align: center;">
                            <i data-lucide="alert-triangle" style="width: 48px; height: 48px; color: var(--danger); margin-bottom: var(--space-4);"></i>
                            <h3 style="font-size: var(--font-size-heading);">Error Loading Members</h3>
                            <p style="color: var(--text-secondary); margin-top: var(--space-2);"><%= error %></p>
                        </div>
                    <% } else if (members.length === 0) { %>
                        <div style="padding: var(--space-10) var(--space-6); text-align: center;">
                            <% if (locals.search) { %>
                                <i data-lucide="search" style="width: 48px; height: 48px; color: var(--text-muted); opacity: 0.5; margin-bottom: var(--space-4);"></i>
                                <h3 style="font-size: var(--font-size-heading);">No members found</h3>
                                <p style="color: var(--text-secondary); margin-top: var(--space-2);">Try adjusting your search.</p>
                                <a href="/admin/members" class="btn btn-secondary" style="margin-top: var(--space-4);">Clear Search</a>
                            <% } else { %>
                                <i data-lucide="users" style="width: 48px; height: 48px; color: var(--text-muted); opacity: 0.5; margin-bottom: var(--space-4);"></i>
                                <h3 style="font-size: var(--font-size-heading);">No members yet</h3>
                                <p style="color: var(--text-secondary); margin-top: var(--space-2);">Add your first member to start managing the library community.</p>
                                <button class="btn btn-primary" style="margin-top: var(--space-4);" onclick="openAddDrawer()">Add Member</button>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="table-container">
                            <table class="table responsive-table">
                                <thead>
                                    <tr>
                                        <th>Member</th>
                                        <th>Contact</th>
                                        <th>Address</th>
                                        <th>Membership Date</th>
                                        <th style="width: 80px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% members.forEach(member => { %>
                                        <tr>
                                            <td>
                                                <div style="font-weight: 500; color: var(--text-primary);"><%= member.name %></div>
                                                <div class="member-meta"><%= member.email %></div>
                                            </td>
                                            <td>
                                                <% if (member.phone) { %>
                                                    <%= member.phone %>
                                                <% } else { %>
                                                    <span style="color: var(--text-muted);">Not provided</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (member.address) { %>
                                                    <div style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= member.address %>">
                                                        <%= member.address %>
                                                    </div>
                                                <% } else { %>
                                                    <span style="color: var(--text-muted);">Not provided</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <%= new Date(member.membership_date).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <div class="overflow-menu-container">
                                                    <button class="btn btn-ghost icon-btn" onclick="toggleMenu('<%= member.member_id %>')" aria-label="Member actions">
                                                        <i data-lucide="more-vertical" style="width: 16px;"></i>
                                                    </button>
                                                    <div class="overflow-menu" id="menu-<%= member.member_id %>">
                                                        <button class="overflow-item" onclick="openEditDrawer(<%= JSON.stringify(member) %>)">
                                                            <i data-lucide="edit" style="width: 14px;"></i> Edit
                                                        </button>
                                                        <button class="overflow-item danger" onclick="confirmDelete('<%= member.member_id %>', '<%= member.name.replace(/'/g, "\\'") %>')">
                                                            <i data-lucide="trash-2" style="width: 14px;"></i> Delete
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div style="padding: 0 var(--space-6);">
                            <div class="pagination">
                                <div class="pagination-info">
                                    Showing <%= (page - 1) * 10 + 1 %>–<%= Math.min(page * 10, totalRows) %> of <%= totalRows %> members
                                </div>
                                <div class="pagination-controls">
                                    <a href="?q=<%= search %>&page=<%= page - 1 %>" 
                                       class="btn btn-secondary" 
                                       <%= page <= 1 ? 'disabled style="pointer-events:none; opacity:0.5;"' : '' %>>
                                        Previous
                                    </a>
                                    <span style="display:flex; align-items:center; padding:0 var(--space-2); font-weight:500;">
                                        Page <%= page %> of <%= totalPages %>
                                    </span>
                                    <a href="?q=<%= search %>&page=<%= page + 1 %>" 
                                       class="btn btn-secondary"
                                       <%= page >= totalPages ? 'disabled style="pointer-events:none; opacity:0.5;"' : '' %>>
                                        Next
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>
        
        <div class="sidebar-backdrop"></div>
        
        <!-- Add / Edit Drawer -->
        <div class="drawer-overlay" id="formDrawerOverlay" onclick="closeDrawer()"></div>
        <div class="drawer" id="formDrawer" aria-modal="true" role="dialog" aria-labelledby="drawerTitle">
            <form id="memberForm" method="POST" action="/admin/members" onsubmit="return handleFormSubmit()">
                <div class="drawer-header">
                    <h2 id="drawerTitle" style="font-size: var(--font-size-heading);">Add Member</h2>
                    <button type="button" class="btn btn-ghost icon-btn" onclick="closeDrawer()" aria-label="Close drawer">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label class="form-label" for="name">Full Name *</label>
                        <input type="text" id="name" name="name" class="form-control" required placeholder="e.g. Jane Doe">
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="email">Email *</label>
                        <input type="email" id="email" name="email" class="form-control" required placeholder="e.g. jane@example.com">
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="phone">Phone</label>
                        <input type="tel" id="phone" name="phone" class="form-control" placeholder="Optional phone number">
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="address">Address</label>
                        <textarea id="address" name="address" class="form-control" rows="3" placeholder="Optional physical address"></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="membership_date">Membership Date *</label>
                        <input type="date" id="membership_date" name="membership_date" class="form-control" required>
                    </div>
                </div>
                <div class="drawer-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeDrawer()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save Member</button>
                </div>
            </form>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal-overlay" id="deleteModalOverlay">
            <div class="modal" role="dialog" aria-labelledby="deleteModalTitle" aria-modal="true">
                <div class="modal-header">
                    <h2 id="deleteModalTitle" style="font-size: var(--font-size-heading); color: var(--danger); display: flex; align-items: center; gap: var(--space-2);">
                        <i data-lucide="alert-triangle"></i> Delete Member
                    </h2>
                </div>
                <div class="modal-body">
                    <p style="margin-bottom: var(--space-2);">Are you sure you want to delete <strong id="deleteMemberName"></strong>?</p>
                    <p style="font-size: var(--font-size-meta); color: var(--text-muted);">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <form id="deleteForm" method="POST" action="">
                        <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                        <button type="submit" class="btn btn-danger" id="deleteSubmitBtn">Delete Member</button>
                    </form>
                </div>
            </div>
        </div>

    </div>
    
    <script src="/js/shell.js"></script>
    <script>
        lucide.createIcons();

        // Toast logic based on URL params
        const urlParams = new URLSearchParams(window.location.search);
        const errorMsg = urlParams.get('error');
        const successMsg = urlParams.get('success');

        if (errorMsg) showToast(errorMsg, 'error');
        if (successMsg) showToast(successMsg, 'success');

        function showToast(message, type) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            const iconName = type === 'success' ? 'check-circle' : 'alert-circle';
            toast.innerHTML = `
                <i data-lucide="${iconName}" class="toast-icon"></i>
                <div style="font-weight: 500;">${message}</div>
            `;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 200);
            }, 5000);
            
            // Clean URL
            const url = new URL(window.location);
            url.searchParams.delete(type);
            window.history.replaceState({}, '', url);
        }

        // Overflow Menu Logic
        let activeMenu = null;
        function toggleMenu(id) {
            const menu = document.getElementById(`menu-${id}`);
            if (activeMenu && activeMenu !== menu) {
                activeMenu.classList.remove('visible');
            }
            if (menu.classList.contains('visible')) {
                menu.classList.remove('visible');
                activeMenu = null;
            } else {
                menu.classList.add('visible');
                activeMenu = menu;
            }
        }

        document.addEventListener('click', (e) => {
            if (activeMenu && !e.target.closest('.overflow-menu-container')) {
                activeMenu.classList.remove('visible');
                activeMenu = null;
            }
        });

        // Drawer Logic
        const drawer = document.getElementById('formDrawer');
        const drawerOverlay = document.getElementById('formDrawerOverlay');
        const form = document.getElementById('memberForm');
        const drawerTitle = document.getElementById('drawerTitle');

        function openAddDrawer() {
            drawerTitle.textContent = 'Add Member';
            form.action = '/admin/members';
            form.reset();
            document.getElementById('membership_date').value = new Date().toISOString().split('T')[0];
            drawer.classList.add('open');
            drawerOverlay.classList.add('visible');
        }

        function openEditDrawer(member) {
            drawerTitle.textContent = 'Edit Member';
            form.action = `/admin/members/${member.member_id}/update`;
            
            document.getElementById('name').value = member.name;
            document.getElementById('email').value = member.email;
            document.getElementById('phone').value = member.phone || '';
            document.getElementById('address').value = member.address || '';
            document.getElementById('membership_date').value = member.membership_date.split('T')[0];

            drawer.classList.add('open');
            drawerOverlay.classList.add('visible');
            if (activeMenu) activeMenu.classList.remove('visible');
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            drawerOverlay.classList.remove('visible');
        }

        function handleFormSubmit() {
            document.getElementById('submitBtn').textContent = 'Saving...';
            document.getElementById('submitBtn').disabled = true;
            return true;
        }

        // Delete Modal Logic
        const deleteModal = document.getElementById('deleteModalOverlay');
        const deleteForm = document.getElementById('deleteForm');

        function confirmDelete(id, name) {
            document.getElementById('deleteMemberName').textContent = name;
            deleteForm.action = `/admin/members/${id}/delete`;
            deleteModal.classList.add('visible');
            if (activeMenu) activeMenu.classList.remove('visible');
        }

        function closeDeleteModal() {
            deleteModal.classList.remove('visible');
        }

        deleteForm.addEventListener('submit', () => {
            document.getElementById('deleteSubmitBtn').textContent = 'Deleting...';
            document.getElementById('deleteSubmitBtn').disabled = true;
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeDrawer();
                closeDeleteModal();
            }
        });
    </script>
</body>
</html>
