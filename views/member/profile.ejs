<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title>My Profile - Member Portal</title>
</head>
<body>
    <div class="app-layout fade-in">
        <%- include('../partials/member-sidebar', { currentPath: '/member/profile' }) %>
        
        <div class="main-content">
            <%- include('../partials/topbar') %>
            
            <main class="page-content slide-up">
                <% 
                    function formatSafeDate(d) {
                        if (!d) return 'N/A';
                        const date = new Date(d);
                        if (isNaN(date.getTime())) return 'N/A';
                        return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                    }
                %>

                <!-- Shared Page Header -->
                <%- include('../partials/page-header', {
                    title: 'My Profile',
                    description: 'Manage your personal details and contact settings.',
                    breadcrumbs: [
                        { label: 'Portal', href: '/member' },
                        { label: 'Profile' }
                    ]
                }) %>

                <!-- Feedback Notifications -->
                <% if (locals.success) { %>
                    <div class="alert alert-success" role="status" aria-live="polite">
                        <i data-lucide="check-circle" class="alert-icon" aria-hidden="true"></i>
                        <div class="alert-content">
                            <div class="alert-title">Profile Updated</div>
                            <div class="alert-message"><%= success %></div>
                        </div>
                    </div>
                <% } %>

                <% if (locals.error) { %>
                    <div class="alert alert-danger" role="alert" aria-live="assertive">
                        <i data-lucide="alert-circle" class="alert-icon" aria-hidden="true"></i>
                        <div class="alert-content">
                            <div class="alert-title">Unable to Save Profile</div>
                            <div class="alert-message"><%= error %></div>
                        </div>
                    </div>
                <% } %>

                <% if (locals.currentMember) { %>
                    <div class="profile-grid">
                        <!-- Profile Summary Column -->
                        <div class="profile-card">
                            <div class="member-header">
                                <div class="avatar-large" aria-hidden="true">
                                    <%= (currentMember.name || currentMember.username || 'M').trim().charAt(0).toUpperCase() %>
                                </div>
                                <div class="member-display-name"><%= currentMember.name || currentMember.username || 'Library Member' %></div>
                                <div class="member-display-email"><%= currentMember.email %></div>
                                <div style="margin-top: var(--space-2);">
                                    <span class="status-badge badge-available" role="status">
                                        <i data-lucide="shield-check" class="status-badge-icon" aria-hidden="true"></i>
                                        <span>Active Member</span>
                                    </span>
                                </div>
                            </div>

                            <div class="info-list">
                                <div class="info-row">
                                    <span class="info-row-label">Member ID</span>
                                    <span class="info-row-value" style="font-family: monospace;">#<%= currentMember.member_id %></span>
                                </div>
                                <div class="info-row">
                                    <span class="info-row-label">Membership Date</span>
                                    <span class="info-row-value"><%= formatSafeDate(currentMember.membership_date) %></span>
                                </div>
                                <div class="info-row">
                                    <span class="info-row-label">Library Branch</span>
                                    <span class="info-row-value"><%= currentMember.admin_id ? ('Central Library (Admin #' + currentMember.admin_id + ')') : 'Self-Registered' %></span>
                                </div>
                            </div>

                            <% if (locals.metrics) { %>
                                <div style="margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--border-color);">
                                    <div style="font-size: var(--font-size-meta); font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-3);">
                                        Borrowing Activity
                                    </div>
                                    <div class="stat-card-grid cols-2" style="margin-bottom: 0;">
                                        <div class="stat-box">
                                            <div class="stat-num"><%= metrics.activeLoans %></div>
                                            <div class="stat-desc">Active Loans</div>
                                        </div>
                                        <div class="stat-box">
                                            <div class="stat-num <%= metrics.overdueLoans > 0 ? 'overdue-text' : '' %>">
                                                <%= metrics.overdueLoans %>
                                            </div>
                                            <div class="stat-desc">Overdue</div>
                                        </div>
                                        <div class="stat-box">
                                            <div class="stat-num"><%= metrics.returnedBooks %></div>
                                            <div class="stat-desc">Returned</div>
                                        </div>
                                        <div class="stat-box">
                                            <div class="stat-num <%= metrics.totalOverdueFine > 0 ? 'overdue-text' : '' %>">
                                                ₹<%= parseFloat(metrics.totalOverdueFine).toFixed(0) %>
                                            </div>
                                            <div class="stat-desc">Fines Due</div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- Editable Details Column -->
                        <div class="profile-card">
                            <h2 style="font-size: var(--font-size-heading); margin-bottom: var(--space-2); color: var(--text-primary);">Personal & Contact Details</h2>
                            <p style="color: var(--text-secondary); margin-bottom: var(--space-6); font-size: var(--font-size-body);">
                                Keep your contact information up to date so you receive library notices and loan reminders.
                            </p>

                            <form method="POST" action="/member/profile" id="profileForm">
                                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                                <div class="form-group">
                                    <label class="form-label" for="memberName">
                                        Full Name
                                    </label>
                                    <input 
                                        type="text" 
                                        id="memberName" 
                                        name="name" 
                                        class="form-control" 
                                        value="<%= currentMember.name || '' %>" 
                                        minlength="2" 
                                        maxlength="100" 
                                        autocomplete="name"
                                        placeholder="Optional full name"
                                        aria-describedby="nameHelper"
                                    >
                                    <div id="nameHelper" class="form-helper">Optional. 2–100 characters when provided.</div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="memberEmail">
                                        Email Address
                                        <span class="field-badge-readonly">
                                            <i data-lucide="lock" style="width: 10px; height: 10px;" aria-hidden="true"></i>
                                            Read-only
                                        </span>
                                    </label>
                                    <input 
                                        type="email" 
                                        id="memberEmail" 
                                        class="form-control input-readonly" 
                                        value="<%= currentMember.email || '' %>" 
                                        readonly 
                                        disabled 
                                        tabindex="-1"
                                        aria-describedby="emailHelper"
                                    >
                                    <div id="emailHelper" class="form-helper">Email address cannot be changed directly. Contact the library administrator for updates.</div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="memberPhone">Phone Number</label>
                                    <input 
                                        type="tel" 
                                        id="memberPhone" 
                                        name="phone" 
                                        class="form-control" 
                                        placeholder="e.g. +1 (555) 019-2834 or 9876543210" 
                                        value="<%= currentMember.phone || '' %>" 
                                        maxlength="20"
                                        pattern="^[0-9+\s\(\)\-]+$"
                                        autocomplete="tel"
                                        aria-describedby="phoneHelper"
                                    >
                                    <div id="phoneHelper" class="form-helper">Optional. Maximum 20 characters (digits, spaces, +, -, and parentheses).</div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="memberAddress">Home Address</label>
                                    <textarea 
                                        id="memberAddress" 
                                        name="address" 
                                        class="form-control" 
                                        rows="3" 
                                        placeholder="Enter your residential or mailing address" 
                                        maxlength="500"
                                        autocomplete="street-address"
                                        aria-describedby="addressHelper"
                                    ><%= currentMember.address || '' %></textarea>
                                    <div id="addressHelper" class="form-helper">Optional. Maximum 500 characters.</div>
                                </div>

                                <div style="display: flex; justify-content: flex-end; align-items: center; gap: var(--space-3); margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--border-color); flex-wrap: wrap;">
                                    <a href="/member" class="btn btn-secondary">
                                        Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary" id="saveProfileBtn">
                                        <i data-lucide="save" aria-hidden="true"></i>
                                        <span>Save Changes</span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i data-lucide="user-x" aria-hidden="true"></i>
                        </div>
                        <h3 class="empty-state-title">Profile Not Found</h3>
                        <p class="empty-state-text">No active library member account could be loaded.</p>
                        <a href="/member" class="btn btn-secondary">Return to Dashboard</a>
                    </div>
                <% } %>
            </main>
        </div>
        
        <div class="sidebar-backdrop"></div>
    </div>
    
    <script src="/js/shell.js"></script>
    <script>
        lucide.createIcons();

        // Client-side validation and duplicate submission protection
        const profileForm = document.getElementById('profileForm');
        const saveBtn = document.getElementById('saveProfileBtn');
        let isSubmitting = false;

        if (profileForm && saveBtn) {
            profileForm.addEventListener('submit', function(e) {
                if (isSubmitting) {
                    e.preventDefault();
                    return;
                }

                const nameInput = document.getElementById('memberName');
                const nameVal = nameInput ? nameInput.value.trim() : '';
                if (nameVal && nameVal.length < 2) {
                    e.preventDefault();
                    alert('Full Name must be at least 2 characters.');
                    if (nameInput) nameInput.focus();
                    return;
                }
                if (nameVal.length > 100) {
                    e.preventDefault();
                    alert('Full Name cannot exceed 100 characters.');
                    if (nameInput) nameInput.focus();
                    return;
                }

                const phoneInput = document.getElementById('memberPhone');
                if (phoneInput && phoneInput.value.trim()) {
                    const phoneVal = phoneInput.value.trim();
                    if (phoneVal.length > 20) {
                        e.preventDefault();
                        alert('Phone number cannot exceed 20 characters.');
                        phoneInput.focus();
                        return;
                    }
                    const phoneRegex = /^[0-9+\-()\s]+$/;
                    if (!phoneRegex.test(phoneVal)) {
                        e.preventDefault();
                        alert('Phone number can only contain digits, spaces, +, -, and parentheses.');
                        phoneInput.focus();
                        return;
                    }
                }

                const addressInput = document.getElementById('memberAddress');
                if (addressInput && addressInput.value.trim().length > 500) {
                    e.preventDefault();
                    alert('Home address cannot exceed 500 characters.');
                    addressInput.focus();
                    return;
                }

                // Prevent rapid repeated submissions
                isSubmitting = true;
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i data-lucide="loader-2" class="status-badge-icon spin" aria-hidden="true"></i> <span>Saving...</span>';
                if (window.lucide) lucide.createIcons();
            });

            // Recovery for back/forward cache navigation
            window.addEventListener('pageshow', function() {
                isSubmitting = false;
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i data-lucide="save" aria-hidden="true"></i> <span>Save Changes</span>';
                    if (window.lucide) lucide.createIcons();
                }
            });
        }
    </script>
</body>
</html>
